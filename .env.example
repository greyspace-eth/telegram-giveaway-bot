# Telegram
TELEGRAM_TOKEN=your_telegram_bot_token

# Twitter OAuth (v1.1)
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret
TWITTER_TOKEN_KEY=your_twitter_access_token
TWITTER_TOKEN_SECRET=your_twitter_access_token_secret

# Discord OAuth
DISCORD_CONSUMER_KEY=your_discord_client_id
DISCORD_CONSUMER_SECRET=your_discord_client_secret

# Express session
SESSION_SECRET=your_random_session_secret

# Public base URL (use ngrok for local dev)
HTTP_URL=https://your-ngrok-or-domain-url.com

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=tele_giveaway
